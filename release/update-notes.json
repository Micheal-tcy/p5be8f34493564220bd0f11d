  "history_complete_after_build": 33,
  "entries": [
    {
      "note_id": "history-build-34",
      "build_number": 34,
      "commit": "09072c12f6bd25ac0edbfd891c9117e0736a2dd2",
      "tag": "build-34-09072c1",
      "summary": [
        "兼容新版客户端移动模块，名称读取失败不再阻断地图地形显示。"
      ]
    },
    {
      "note_id": "history-build-35",
      "build_number": 35,
      "commit": "317eedff9d633bc11a896de4625fc4f95d064e8e",
      "tag": "build-35-317eedf",
      "summary": [
        "恢复新版客户端中的地图、怪物、掉落及消耗品名称显示。",
        "减少本地源码启动和更新后的重复编译等待。"
      ]
    },
    {
      "note_id": "history-build-36",
      "build_number": 36,
      "commit": "cf77dbf3f70a45ca1e314fef4debcbdc27397a53",
      "tag": "build-36-cf77dbf",
      "summary": [
        "修复轻功默认增益图标识别，保留用户显式设置。",
        "本地源码启动显示检查和编译进度。"
      ]
    },
    {
      "note_id": "history-build-37",
      "build_number": 37,
      "commit": "01695ff7ee615971edd7280fbdce9ffd8af52446",
      "tag": "build-37-01695ff",
      "summary": [
        "新增新怪观察等待开关，默认关闭并随策略保存。"
      ]
    },
    {
      "note_id": "history-build-38",
      "build_number": 38,
      "commit": "22442f3703a924a944898932c5a05752919f29ff",
      "tag": "build-38-22442f3",
      "summary": [
        "改善跨层选路与悬空绳抓取，按怪物数量和路线耗时选择平台。",
        "减少巡逻立即往返及抓绳失败后的重复尝试。"
      ]
    },
    {
      "note_id": "history-build-39",
      "build_number": 39,
      "commit": "baee1e0028901c17867aacc5863e23eca1b01cec",
      "tag": "build-39-baee1e0",
      "summary": [
        "补全攻击药丸和龙血的自动补充说明与回归验证，沿用原有通用药剂入口。"
      ]
    },
    {
      "note_id": "history-build-40",
      "build_number": 40,
      "commit": "9a5a0859777d8357c4e4c4a3435aba79e33d15e9",
      "tag": "build-40-9a5a085",
      "summary": [
        "恢复新版地图的怪物列表、底图和默认全图移动范围。",
        "修复绳底归轴时错误判定转场越界而停止的问题。"
      ]
    },
    {
      "note_id": "history-build-41",
      "build_number": 41,
      "commit": "546ef4f585d7e1868c9a343b47a52a198f60368e",
      "tag": "build-41-546ef4f",
      "summary": [
        "补齐船长一至三转攻击与增益技能，支持导航标记和召唤维护。",
        "可用枪系技能支持经过近身条件验证的跳射。"
      ]
    },
    {
      "note_id": "history-build-42",
      "build_number": 42,
      "commit": "65ef7df0c9690373e6f00d4c279a9e37cd680685",
      "tag": "build-42-65ef7df",
      "summary": [
        "角色靠近移动范围边缘时，可用的原地攻击不再被贴边撤离反复打断。"
      ]
    },
    {
      "note_id": "history-build-43",
      "build_number": 43,
      "commit": "bd530f6433db36982b06c18c27031ded126b7983",
      "tag": "build-43-bd530f6",
      "summary": [
        "适配十月二十三日客户端更新，恢复移动、增益和地图数据读取。",
        "修复部分地图传送点数据导致整张地图地形无法载入的问题。"
      ]
    },
    {
      "note_id": "history-build-44",
      "build_number": 44,
      "commit": "f1a8454dc6703ed1ef6a107c33d2b03f75b762fd",
      "tag": "build-44-f1a8454",
      "summary": [
        "支持配置游戏攻击宏并按成员顺序确认施放。",
        "恢复技能名称，补齐多职业攻击及落叶斩的移动攻击条件。"
      ]
    },
    {
      "note_id": "history-build-45",
      "build_number": 45,
      "commit": "e313dd321f8827a9e077b4e5bb985a0fea5b22c6",
      "tag": "build-45-e313dd3",
      "summary": [
        "新怪观察等待支持随机时间上下限。",
        "挂机监控可切换攻击和增益方案，以及运行日志和掉落日志。"
      ]
    },
    {
      "note_id": "history-build-46",
      "build_number": 46,
      "commit": "ed9a691b10f77ff2165f779a69a09bdec201cc3a",
      "tag": "build-46-ed9a691",
      "summary": [
        "修复普通刷怪、怪物消失和空挥反复重置无伤害施放计时的问题。"
      ]
    },
    {
      "note_id": "history-build-47",
      "build_number": 47,
      "commit": "e8bc29c0d5958936182061ef24e975ae8f40c2ca",
      "tag": "build-47-e8bc29c",
      "summary": [
        "不再为群攻规划圈外站位，合法站位只能打到一只时优先可用单体。",
        "日志新增独立报警记录页，脚本超时等异常停机也会触发报警。"
      ]
    },
    {
      "note_id": "update-history-overview-20261024",
      "build_number": 48,
      "commit": "b36009fbeb1e37017feb44ea90ee3e6d0cff501d",
      "tag": "build-48-b36009f",
      "summary": [
        "更新面板增加历史更新概览，可按版本查看构建 1～47 中 46 个真实发布版本的简要更新内容。",
        "源码和本地版本也可离线浏览正式历史，尚未发布的本地改动单独显示。",
        "更新说明未发布、网络失败和校验失败分别提示，可独立重试说明，不打断下载或安装准备。"
      ]
    },
    {
      "note_id": "updater-resume-notes-20261024",
      "build_number": 48,
      "commit": "b36009fbeb1e37017feb44ea90ee3e6d0cff501d",
      "tag": "build-48-b36009f",
      "summary": [
        "正式版本号随每次构建递增；独立更新面板集中显示进度、速度和预计剩余时间。",
        "下载支持暂停、断网重连和退出后继续，弱网中断保留已下载内容，校验完成后再安装重启。",
        "更新面板直接展示本次及跨版本更新简述，说明从每次提交的 changelog 自动生成。"
      ]
    },
    {
      "note_id": "release-payload-eol-20261024",
      "build_number": 49,
      "commit": "4b5c5c8864350769086a6f8cec9c3ace3f133c81",
      "tag": "build-49-4b5c5c8",
      "summary": [
        "修复发布过程中更新说明行尾被 Git 转换、导致最终哈希校验失败的问题；保留完整的原始文件校验。"
      ]
    },
    {
      "note_id": "chat-notifications-logs-20261024",
      "build_number": 50,
      "commit": "e5a46971329b8ceeb6b588e5fb8c9ba656fe9234",
      "tag": "build-50-e5a4697",
      "summary": [
        "新增“聊天提醒”开关，可为其他玩家的所有人频道新消息显示系统提示，自动排除自身发言。",
        "所有人与组队聊天支持分别保存日志，包含自身发言；日志与提醒可独立开关，设置自动保存。",
        "初次连接不回放旧消息，关闭提醒或切换角色会清除待发提示；聊天不播放掉落语音，也不会被金色掉落清除。"
      ]
    },
    {
      "note_id": "bow-terrain-targeting-20261024",
      "build_number": 51,
      "commit": "02e5e01893634f214fd8981687b6cf39735ae6fb",
      "tag": "build-51-02e5e01",
      "summary": [
        "修复箭扫射/四连射只按射程矩形判断、隔着起伏地面连续空放后触发不掉血报警的问题；遇到遮挡时先在允许范围内寻找可射击站位。",
        "恢复对较高平台及移动范围外、但可从范围内真实选中的目标判断。保留攻击连续持键和 100ms 重复间隔，不增加施放等待。"
      ]
    },
    {
      "note_id": "fullscreen-chat-positioning-map-range-20261026",
      "build_number": 58,
      "commit": "752a9d0a782184c1f60685b4f4d7c59804c1c644",
      "tag": "build-58-752a9d0",
      "summary": [
        "聊天新增可选全屏优先横幅与 Windows 系统通知短音，连续消息即时合并；运行日志和挂机监控可切换查看聊天记录。",
        "群攻技能可优先短距离调整站位，途中能攻击多个目标时立即出手；地图移动范围支持按地图共用或随攻击策略分别保存。",
        "修复聊天旧摘要被丢弃、部分掉落声音提交失败不重试的问题，并补齐更新说明以恢复新版安装包发布。"
      ]
    },
    {
      "note_id": "manual-runtime-expedition-20261026",
      "build_number": 59,
      "commit": "ac551e91076ba90d175e7355ee123f1c67608cfc",
      "tag": "build-59-ac551e9",
      "summary": [
        "新增“远征模式”：每次开始挂机默认关闭，运行后可手动开启，临时忽略攻击白名单及战斗异常报警。",
        "狩猎验证、巡查、地图广播和运行安全保护继续生效；关闭模式恢复原设置，停止或重新挂机不会继承。"
      ]
    },
    {
      "note_id": "buster-depth-expedition-priority-20261026",
      "build_number": 60,
      "commit": "89c1f3b6e7e61d847c62df37bd9c52926232f99e",
      "tag": "build-60-89c1f3b",
      "summary": [
        "枪连击新增专属进范围深度百分比，深入后才起手，持续攻击保留完整射程，减少卡边和反复短移。",
        "远征模式旁新增优先锁定下拉框，也可在地图点选怪物设为优先目标；死亡、离场或开始新一轮后清除。"
      ]
    },
    {
      "note_id": "puppet-buff-facing-20261026",
      "build_number": 61,
      "commit": "339e619dda661e0ce12f2b9e500199d695dc4052",
      "tag": "build-61-339e619",
      "summary": [
        "弓手和弩手替身术支持单独加入技能优先级，只有自身替身 Buff 实际消失后才补放，效果仍存在时不重复释放。",
        "增加默认关闭的“转身释放”，随策略保存；默认朝攻击方向释放，勾选后先确认转身再施放。"
      ]
    },
    {
      "note_id": "silver-hawk-auto-buff-20261027",
      "build_number": 61,
      "commit": "339e619dda661e0ce12f2b9e500199d695dc4052",
      "tag": "build-61-339e619",
      "summary": [
        "自动 Buff 支持单独添加银鹰召唤，只有对应效果实际消失后才补放，存在期间不提前刷新。",
        "召唤前读取真实等级、蓝量、前置技能和召唤石数量，条件不足时提示等待。"
      ]
    },
    {
      "note_id": "client-compatibility-20261027",
      "build_number": 62,
      "commit": "9321bfa6bf462a90dded0b072da2d997831d8df8",
      "tag": "build-62-9321bfa",
      "summary": [
        "适配新版客户端的地图资源与移动读取，补充新版地图物件的加载支持。",
        "修复客户端更新后 Buff 图标、掉落特效、落叶斩和弓系目标判断的兼容问题。"
      ]
    },
    {
      "note_id": "combat-edge-chase-20261027",
      "build_number": 63,
      "commit": "4d8f04facb8a62efd45928f163780c380ed9c74c",
      "tag": "build-63-4d8f04f",
      "summary": [
        "修复追怪到移动边缘后反复向内撤离、又向外追怪造成的左右摇摆。",
        "追怪选点提前预留实时速度对应的停步距离，撤离后不会再次追向无法安全到达的站位；当前位置已经能攻击或治疗时继续施放。"
      ]
    },
    {
      "note_id": "combat-pe-timestamp-20261027",
      "build_number": 64,
      "commit": "fa2fca87ffa01319f20ae926d9b156d0b1c4f994",
      "tag": "build-64-fa2fca8",
      "summary": [
        "修复箭扫射和落叶斩因客户端编译时间戳变化，被误判为尚未兼容、无法开始挂机的问题。"
      ]
    },
    {
      "note_id": "all-job-client-compatibility-20261027-evening",
      "build_number": 65,
      "commit": "5b81e6c4cd1e6eb2758e156d21a9fc7225338d00",
      "tag": "build-65-5b81e6c",
      "summary": [
        "修复客户端再次更新后技能名称、攻击技能列表和宏成员名称无法加载的问题。",
        "适配新版 Buff 图标和掉落特效读取，保留既有角色配置与技能方案。"
      ]
    },
    {
      "note_id": "run-drop-log-clear-20261028",
      "build_number": 66,
      "commit": "06b9cc00068635c466552084ca3ef943e6190e45",
      "tag": "build-66-06b9cc0",
      "summary": [
        "运行日志与掉落日志增加“清空列表”，日志页和挂机监控均可使用。",
        "仅清空当前显示，后续新记录继续显示；保留已保存的运行诊断日志，已清空掉落不会因后续金光更新重新出现。",
        "掉落记录可显示实际拾取玩家，宠物拾取显示其归属玩家；没有捕获到对应拾取信息时明确标为未确认。"
      ]
    },
    {
      "note_id": "client-compatibility-20261028",
      "build_number": 67,
      "commit": "26a39787189f5d3889ecc2d2f6d2fba90b09b288",
      "tag": "build-67-26a3978",
      "summary": [
        "修复新版客户端的受保护地图、技能与怪物名称读取。",
        "适配玩家移动、宠物隔离、Buff 图标、掉落特效，以及落叶斩和弓弩选敌的新版位置。"
      ]
    },
    {
      "note_id": "adaptive-map-walking-20261028",
      "build_number": 68,
      "commit": "20a02df2fc16f4a34a729b5cff73cf9f1c32ec13",
      "tag": "build-68-20a02df",
      "summary": [
        "地图、技能和怪物名称、玩家移动增加受限自动适配，减少客户端仅调整已知代码位置时的重复更新。",
        "保留完整校验；无法确认的代码或数据变化仍会提示不兼容。"
      ]
    },
    {
      "note_id": "adaptive-buff-drop-attack-20261028",
      "build_number": 69,
      "commit": "8490912d58333b860f386e1fdc28f84a12e7941a",
      "tag": "build-69-8490912",
      "summary": [
        "Buff 图标、掉落特效、落叶斩和弓弩选敌接入受限自动适配，减少客户端仅调整已知代码位置时的重复修复。",
        "保留旧版本支持和完整校验；代码逻辑或数据结构发生无法确认的变化时，仍提示不兼容。"
      ]
    },
    {
      "note_id": "expanded-combat-skills-20261028",
      "build_number": 70,
      "commit": "75d540482f843cbea358074ee65cd2ac590a0bd1",
      "tag": "build-70-75d5404",
      "summary": [
        "修复属性攻击的范围识别，并新增支持 41 项非战神攻击技能，覆盖部分近战、法术、弓弩、飞镖及能量、变身攻击。",
        "末日烈焰会等待最终施法动作结束，再恢复移动和 Buff；特殊条件失效时停止攻击，避免重复按键或打断。",
        "本次仍非全技能覆盖；蓄力、持续攻击、链式攻击及部分召唤等功能尚未完成。"
      ]
    },
    {
      "note_id": "late-client-and-damage-buffs-20261028",
      "build_number": 71,
      "commit": "e31567a94bde21af839a5afceb2e9faf3ab44706",
      "tag": "build-71-e31567a",
      "summary": [
        "适配晚间客户端更新，修复角色数据过期导致的“请先连接角色并等待实时坐标”，恢复地图、名称、移动、Buff 图标、掉落及已有攻击读取。",
        "修正骑士属性赋予等增益的分类：烈焰钝器等技能的伤害倍率不再被误认为一次攻击，单技能和纯 Buff 宏均使用正确分类。",
        "仍拒绝真正攻击、未知和不完整定义；保留现有策略与个人配置。"
      ]
    },
    {
      "note_id": "ordinary-attack-prepare-guard-20261028",
      "build_number": 72,
      "commit": "3537469b421264169009ebb1f4d548700feb720b",
      "tag": "build-72-3537469",
      "summary": [
        "修复箭雨、箭扫射等普通攻击被误判为外部准备施法，等待后停止挂机的问题。",
        "普通攻击保持原释放节奏；末日烈焰和真实外部准备施法继续保留生命周期保护。"
      ]
    },
    {
      "note_id": "roar-no-chase-20261029",
      "build_number": 73,
      "commit": "fb154d86207f926d92e535f1874cd711b0c5be48",
      "tag": "build-73-fb154d8",
      "summary": [
        "龙咆哮的技能设置新增“不寻怪”：只在当前位置满足施放条件时攻击，不为该技能追怪或寻找群攻站位。",
        "默认关闭，原有方案保持原行为；是否允许无怪施放仍由“忽略目标数量”单独控制。"
      ]
    },
    {
      "note_id": "expedition-selection-20261029",
      "build_number": 74,
      "commit": "2ed29b53f6df1306b87de2eab269010ece960068",
      "tag": "build-74-2ed29b5",
      "summary": [
        "远征模式支持开始前勾选和选择目标，同一连接下停止再启动可继续使用临时选择。",
        "Boss 多部位在目标列表与地图显示一致的序号，当前锁定目标在地图突出显示。",
        "运行中可以更换或取消锁定；已发起的宏、准备施法及转场按安全规则结束后再切换，避免误停或重发。"
      ]
    },
    {
      "note_id": "local-log-time-20261029",
      "build_number": 75,
      "commit": "75109a5db04159293b14dbcc3e1659bca195791e",
      "tag": "build-75-75109a5",
